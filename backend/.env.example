# ==============================================================================
# Floral Delight Backend - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file and rename it to '.env' inside the backend folder.
# 2. Fill in your actual PostgreSQL credentials.
# 3. Never commit '.env' to git version control.
# ==============================================================================

# Django Security Settings
SECRET_KEY=django-insecure-floral-delight-secret-key-change-in-production-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# PostgreSQL Database Configuration
DB_NAME=floral_delight_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=localhost
DB_PORT=5432

# CORS Allowed Origins (Comma-separated client URLs)
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ALL_ORIGINS=True
